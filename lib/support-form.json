{
  "_about": "Field map for the Contact Support issue form (Technical Support and Bug Report). Single source for both the mockup (app/support/) and the WordPress handover form (public/handover/support-form.html, generated by scripts/gen-support-form.mjs). Every field, option, label and help text comes from the three PDF templates (VANTIQ-*-Issue-Submission-Form.pdf, updated 2026-10-20); field names are the PDFs' own form-field names. 'only' lists the deployments a section or field appears for; without it, all three. A 'help' given as an object varies by deployment: each key is a space-separated list of deployments. 'required' marks only what the templates mark required. The one addition the templates don't have is the attachments limits (maxFiles/maxTotalMb/accept), which are placeholders for Support to confirm.",
  "reasons": [
    {
      "value": "technical",
      "label": "Technical Support",
      "icon": "wrench",
      "email": "support@vantiq.com"
    },
    {
      "value": "bug-report",
      "label": "Bug Report",
      "icon": "bug",
      "email": "support@vantiq.com"
    },
    {
      "value": "security",
      "label": "Security Issue",
      "icon": "shield-alert",
      "email": "support@vantiq.com",
      "roles": [
        "employee",
        "admin"
      ]
    },
    {
      "value": "onboarding",
      "label": "Partner Onboarding",
      "icon": "compass",
      "email": "enablement@vantiq.com"
    },
    {
      "value": "sales",
      "label": "Sales Question",
      "icon": "trending-up",
      "email": "enablement@vantiq.com"
    },
    {
      "value": "account-permissions",
      "label": "Account & Permissions",
      "icon": "shield",
      "email": "enablement@vantiq.com"
    },
    {
      "value": "other",
      "label": "Other",
      "icon": "ellipsis",
      "email": "enablement@vantiq.com"
    }
  ],
  "reasonsNote": "Routing follows Vantiq's support policy (community.vantiq.com/support/): Technical Support, Bug Report and Security Issue go to support@vantiq.com; everything else goes to Partner Enablement. 'icon' is a lucide icon name. 'roles' limits a reason to those mockup roles (Security Issue: Vantiq employees and admins only); on WordPress that's a server-side rule, see HANDOVER.md.",
  "deployments": [
    {
      "id": "public",
      "label": "Public Cloud",
      "hint": "",
      "guideline": "https://community.vantiq.com/resourcefiles/support-issue-submission-template/",
      "icon": "cloud"
    },
    {
      "id": "private",
      "label": "Private Cloud",
      "hint": "",
      "guideline": "https://community.vantiq.com/resourcefiles/pc-support-issue-submission-template/",
      "icon": "server"
    },
    {
      "id": "edge",
      "label": "Edge",
      "hint": "Use for Developer Edition too",
      "guideline": "https://community.vantiq.com/resourcefiles/edge-support-issue-submission-template/",
      "icon": "router"
    }
  ],
  "deploymentHelp": "If you can, reproduce the problem on a public cloud installation first. Choose Private Cloud or Edge only if it can't be reproduced there.",
  "issueReasons": [
    "technical",
    "bug-report"
  ],
  "attachments": {
    "name": "attachments[]",
    "label": "Attachments",
    "maxFiles": 10,
    "maxTotalMb": 20,
    "accept": ".zip,.json,.vail,.txt,.log,.xml,.yaml,.yml,.conf,.properties,.csv,.pdf,.png,.jpg,.jpeg,.gif,.webp,.mp4,.mov,.webm",
    "acceptLabel": "ZIP, JSON, logs and text, XML/YAML config, PDF, images, MP4/MOV/WebM video",
    "checklist": {
      "public": [
        {
          "name": "project_export_attached",
          "label": "Project export file"
        },
        {
          "name": "screenshots_attached",
          "label": "Screenshots and/or video that illustrate the problem"
        },
        {
          "name": "other_exports_attached",
          "label": "Exports of other relevant artifacts"
        }
      ],
      "private": [
        {
          "name": "project_export_attached",
          "label": "Project export file"
        },
        {
          "name": "screenshots_attached",
          "label": "Screenshots that illustrate the problem"
        },
        {
          "name": "other_exports_attached",
          "label": "Exports of other relevant artifacts"
        }
      ],
      "edge": [
        {
          "name": "project_export_attached",
          "label": "Project export file"
        },
        {
          "name": "screenshots_attached",
          "label": "Screenshots and/or video that illustrate the problem"
        },
        {
          "name": "other_exports_attached",
          "label": "Exports of other relevant artifacts"
        },
        {
          "name": "logging_output_attached",
          "label": "Logging output",
          "help": "To enable logging, put logback.xml into your config directory and restart the edge node. Windows users should use the Git Bash (not the Cygwin) shell."
        },
        {
          "name": "config_dir_attached",
          "label": "Server config directory contents"
        }
      ]
    },
    "secretsWarning": "Never send any unencrypted license information, passwords, or secrets.",
    "checklistTitle": "Tick what you've attached:",
    "checklistNote": {
      "private": "Please attach all relevant logs."
    }
  },
  "sections": [
    {
      "id": "issue",
      "title": "Issue submission",
      "fields": [
        {
          "name": "customer_name",
          "label": "Customer name",
          "type": "text",
          "placeholder": "Account name",
          "half": true
        },
        {
          "name": "dtc_email",
          "label": "Designated customer contact (DTC)",
          "type": "email",
          "placeholder": "Email address",
          "half": true
        },
        {
          "name": "submission_type",
          "label": "Submission type",
          "type": "select",
          "options": [
            "Defect",
            "Enhancement"
          ],
          "half": true
        },
        {
          "name": "problem_area",
          "label": "Problem area",
          "type": "select",
          "options": [
            "Infrastructure",
            "Vantiq"
          ],
          "only": [
            "private"
          ],
          "half": true
        },
        {
          "name": "severity",
          "label": "Severity",
          "type": "select",
          "options": [
            "1",
            "2",
            "3",
            "4"
          ],
          "half": true
        },
        {
          "name": "release_id",
          "label": "Vantiq release ID",
          "type": "text",
          "placeholder": "Major.Minor.Patch",
          "only": [
            "private"
          ],
          "half": true
        }
      ]
    },
    {
      "id": "access-private",
      "title": "Support team access",
      "description": "If available.",
      "only": [
        "private"
      ],
      "fields": [
        {
          "name": "vantiq_namespace_invite_sent",
          "label": "Vantiq: Invite to the namespace with the problem sent to support@vantiq.com",
          "type": "checkbox"
        },
        {
          "name": "kubectl_credentials_provided",
          "label": "Infrastructure: Kubectl credentials provided (encrypted)",
          "type": "checkbox"
        }
      ]
    },
    {
      "id": "problem",
      "title": "Problem description",
      "fields": [
        {
          "name": "use_case",
          "label": "Use case",
          "type": "textarea",
          "help": "Briefly describe what you are trying to do."
        },
        {
          "name": "product_limitation",
          "label": "Product limitation",
          "type": "textarea",
          "help": {
            "public": "What roadblock are you hitting?",
            "private edge": "What roadblock are you hitting? Describe any workarounds found."
          }
        },
        {
          "name": "customer_impact",
          "label": "Customer impact",
          "type": "textarea",
          "help": "Explain how this affects your application or operations."
        },
        {
          "name": "steps_to_reproduce",
          "label": "Steps to reproduce",
          "type": "textarea",
          "help": "Numbered steps 1-N.",
          "only": [
            "public",
            "edge"
          ]
        },
        {
          "name": "workarounds",
          "label": "Alternatives / workarounds",
          "type": "textarea",
          "help": "Describe any alternatives or workarounds found.",
          "only": [
            "public",
            "private"
          ]
        },
        {
          "name": "error_messages",
          "label": "Error messages",
          "type": "textarea",
          "help": {
            "public edge": "Complete list of error messages.",
            "private": "List error messages."
          }
        }
      ]
    },
    {
      "id": "infra-private",
      "title": "Infrastructure",
      "description": "IDs for access to Vantiq resources.",
      "only": [
        "private"
      ],
      "fields": [
        {
          "name": "github_id",
          "label": "GitHub",
          "type": "text",
          "placeholder": "ID",
          "half": true
        },
        {
          "name": "quay_id",
          "label": "quay.io",
          "type": "text",
          "placeholder": "ID",
          "half": true
        }
      ]
    },
    {
      "id": "cluster-private",
      "title": "Cluster description",
      "description": "This information should be stored with your Account information in Vantiq's Salesforce instance. If not, you will need to provide (update) it.",
      "only": [
        "private"
      ],
      "fields": [
        {
          "name": "iaas",
          "label": "IaaS",
          "type": "select",
          "options": [
            "AWS",
            "Azure",
            "OCI",
            "Other"
          ],
          "half": true
        },
        {
          "name": "system_id",
          "label": "System ID",
          "type": "text",
          "placeholder": "vantiq_system_release, e.g. 3.12.1",
          "half": true
        },
        {
          "name": "k8s_release",
          "label": "k8s release",
          "type": "text",
          "placeholder": "AKS, EKS, OKE, other (specify) + version",
          "half": true
        },
        {
          "name": "front_door_url",
          "label": "Front door URL",
          "type": "url",
          "half": true
        },
        {
          "name": "license_expiration",
          "label": "License expiration",
          "type": "date",
          "half": true
        },
        {
          "name": "cluster_config",
          "label": "Cluster configuration",
          "type": "text",
          "placeholder": "k8sdeploy_clusters, private GitHub repo, ...",
          "half": true
        }
      ]
    },
    {
      "id": "repro",
      "title": "Why the problem will not reproduce on the Public Cloud",
      "only": [
        "private",
        "edge"
      ],
      "fields": [
        {
          "name": "public_cloud_repro",
          "label": "Reproduction attempts and analysis",
          "type": "textarea",
          "help": "Outline the steps taken to attempt to reproduce the problem in a namespace on the public cloud. Include your thoughts on why the problem does not reproduce on the cloud."
        }
      ]
    },
    {
      "id": "ui",
      "title": "Execution environment",
      "description": "Identify UI (check all that apply).",
      "fields": [
        {
          "name": "ui_android",
          "label": "Android",
          "type": "check-detail",
          "placeholder": "Device: Samsung, LG, etc.; OS: from About box"
        },
        {
          "name": "ui_ios",
          "label": "iOS",
          "type": "check-detail",
          "placeholder": "Device: iPhone model; OS: from More tab"
        },
        {
          "name": "ui_modelo",
          "label": "Modelo",
          "type": "check-detail",
          "placeholder": "Version: Username > About"
        },
        {
          "name": "ui_cli",
          "label": "CLI",
          "type": "check-detail",
          "placeholder": "-v output"
        },
        {
          "name": "ui_browser",
          "label": "Browser",
          "type": "check-detail",
          "placeholder": "e.g. Safari 10.2, Firefox 45.8"
        }
      ]
    },
    {
      "id": "server-public",
      "title": "Identify server",
      "only": [
        "public"
      ],
      "fields": [
        {
          "name": "server_url",
          "label": "Location of Vantiq server",
          "type": "url",
          "placeholder": "URL",
          "half": true
        },
        {
          "name": "server_version",
          "label": "Server version",
          "type": "text",
          "help": "Username > About (optional if public cloud).",
          "half": true
        }
      ]
    },
    {
      "id": "env-public",
      "title": "Vantiq environment",
      "description": "Fill in all that apply.",
      "only": [
        "public"
      ],
      "fields": [
        {
          "name": "org",
          "label": "Organization",
          "type": "text",
          "half": true
        },
        {
          "name": "namespace",
          "label": "Namespace",
          "type": "text",
          "required": true,
          "half": true
        },
        {
          "name": "project",
          "label": "Project",
          "type": "text",
          "required": true,
          "half": true
        },
        {
          "name": "client",
          "label": "Client",
          "type": "text",
          "half": true
        },
        {
          "name": "app",
          "label": "App",
          "type": "text",
          "half": true
        }
      ]
    },
    {
      "id": "access-public",
      "title": "Namespace access",
      "description": "Required if a project export replicating the problem is not provided.",
      "only": [
        "public"
      ],
      "fields": [
        {
          "name": "namespace_invite_sent",
          "label": "Namespace invite sent to support@vantiq.com",
          "type": "checkbox"
        }
      ]
    },
    {
      "id": "server-edge",
      "title": "Identify server",
      "only": [
        "edge"
      ],
      "fields": [
        {
          "name": "server_release_id",
          "label": "Release ID",
          "type": "text",
          "help": "From About box.",
          "half": true
        },
        {
          "name": "server_deployment",
          "label": "How deployed",
          "type": "select",
          "options": [
            "Zip",
            "Docker"
          ],
          "half": true
        }
      ]
    },
    {
      "id": "mongodb-edge",
      "title": "MongoDB",
      "only": [
        "edge"
      ],
      "fields": [
        {
          "name": "mongodb_release_id",
          "label": "Release ID",
          "type": "text",
          "half": true
        },
        {
          "name": "mongodb_deployment",
          "label": "How deployed",
          "type": "select",
          "options": [
            "Zip",
            "Docker"
          ],
          "half": true
        }
      ]
    },
    {
      "id": "servers-private",
      "title": "Identify servers",
      "only": [
        "private"
      ],
      "fields": [
        {
          "name": "server_vantiq_release",
          "label": "Vantiq release ID",
          "type": "text",
          "help": "From About box.",
          "half": true
        },
        {
          "name": "server_mongodb",
          "label": "MongoDB",
          "type": "text",
          "placeholder": "Release ID",
          "half": true
        },
        {
          "name": "server_userdb",
          "label": "UserDB (if configured)",
          "type": "text",
          "placeholder": "Release ID or N/A",
          "half": true
        },
        {
          "name": "server_qdrant",
          "label": "Qdrant (if configured)",
          "type": "text",
          "placeholder": "Release ID or N/A",
          "half": true
        }
      ]
    }
  ],
  "security": {
    "_about": "From 'VANTIQ Internal | Security Issue Submission Template' (PDF, 4 pages). The PDF has no form fields, so names are snake_case of its labels, prefixed security_. Nothing is marked required because the template marks nothing required.",
    "reason": "security",
    "intro": "For M365, identity, endpoint, device-compliance, phishing, and related security issues. Do not use this for Vantiq platform issues involving public cloud, private cloud, edge deployments, namespaces, applications, sources, procedures, or runtime behavior; choose Technical Support or Bug Report for those.",
    "subjectFormat": "SECURITY: [Severity] [Problem Area] — [Short Description]",
    "secretsWarning": "Never include passwords, MFA codes, recovery keys, private keys, customer secrets, or sensitive customer data.",
    "sections": [
      {
        "id": "sec-1",
        "title": "Severity and affected user",
        "description": "The reporter is assumed to be the sender. Only identify an affected user if different from the sender or if additional contact context is needed.",
        "fields": [
          {
            "name": "security_affected_user_email",
            "label": "Affected user email",
            "type": "email",
            "half": true
          },
          {
            "name": "security_contact_method",
            "label": "Best contact method while issue is active",
            "type": "text",
            "half": true
          },
          {
            "name": "security_availability",
            "label": "Availability for troubleshooting",
            "type": "text"
          },
          {
            "name": "security_severity",
            "label": "Severity",
            "type": "radio",
            "options": [
              "Critical - active compromise, lost/stolen device, or severe business/customer impact",
              "High - user blocked from critical work or active customer work",
              "Medium - impaired access with workaround available",
              "Low - question, review, or non-blocking issue"
            ],
            "stacked": true
          }
        ]
      },
      {
        "id": "sec-2",
        "title": "Problem area",
        "fields": [
          {
            "name": "security_problem_area",
            "label": "Problem area",
            "type": "checkgroup",
            "options": [
              "Microsoft 365 access",
              "Outlook / email",
              "Teams",
              "SharePoint / OneDrive",
              "Intune device compliance",
              "Microsoft Defender",
              "Company Portal",
              "Entra ID / Microsoft login",
              "MFA / Microsoft Authenticator",
              "Password / account lockout",
              "Suspicious email / phishing",
              "Lost or stolen device",
              "Suspected malware",
              "Suspected account compromise",
              "Security exception request",
              "Other"
            ],
            "hideLabel": true
          }
        ]
      },
      {
        "id": "sec-3",
        "title": "Affected device",
        "description": "If the device is currently and accurately enrolled in Intune, Security should be able to retrieve most device details directly. In that case, choose the first option and provide the device name if known. Provide additional details only if they are readily available or if enrollment is incomplete/unknown.",
        "fields": [
          {
            "name": "security_enrollment",
            "label": "Enrollment",
            "type": "radio",
            "options": [
              "Device is company-managed and currently enrolled in Intune",
              "Device should be enrolled in Intune, but enrollment may be incomplete",
              "Device is not enrolled in Intune",
              "Enrollment status unknown"
            ],
            "stacked": true,
            "hideLabel": true
          },
          {
            "name": "security_device_name",
            "label": "Device name, if known",
            "type": "text",
            "half": true
          },
          {
            "name": "security_device_compliant",
            "label": "Is the device showing as compliant?",
            "type": "radio",
            "options": [
              "Yes",
              "No",
              "Unknown"
            ],
            "half": true
          },
          {
            "name": "security_last_successful_access",
            "label": "Approximate last successful access from this device",
            "type": "text",
            "half": true
          },
          {
            "name": "security_problem_started",
            "label": "Approximate time the problem started",
            "type": "text",
            "half": true
          },
          {
            "name": "security_device_platform",
            "label": "Device type and platform",
            "type": "checkgroup",
            "options": [
              "Laptop / desktop",
              "Phone / tablet",
              "Windows",
              "macOS",
              "iOS",
              "Android",
              "Linux",
              "Other"
            ]
          },
          {
            "name": "security_os_version",
            "label": "Operating system version",
            "type": "text",
            "half": true
          },
          {
            "name": "security_manufacturer_model",
            "label": "Manufacturer / model",
            "type": "text",
            "half": true
          },
          {
            "name": "security_serial_or_asset_tag",
            "label": "Serial number or asset tag",
            "type": "text"
          },
          {
            "name": "security_apps_installed",
            "label": "Security/M365 apps installed",
            "type": "checkgroup",
            "options": [
              "Microsoft Authenticator",
              "Microsoft Defender",
              "Company Portal",
              "Outlook",
              "Teams"
            ]
          }
        ]
      },
      {
        "id": "sec-4",
        "title": "Network and location context",
        "fields": [
          {
            "name": "security_location_time_zone",
            "label": "User current location / time zone",
            "type": "text"
          },
          {
            "name": "security_network_type",
            "label": "Network type",
            "type": "radio",
            "options": [
              "Home",
              "Office",
              "Hotel",
              "Customer site",
              "Mobile hotspot",
              "Other"
            ]
          },
          {
            "name": "security_using_vpn",
            "label": "Is the user using a VPN?",
            "type": "radio",
            "options": [
              "Yes",
              "No",
              "Unknown"
            ],
            "half": true
          },
          {
            "name": "security_vpn_provider",
            "label": "If yes, identify VPN provider or type",
            "type": "text",
            "half": true
          },
          {
            "name": "security_one_network_only",
            "label": "Is the issue limited to one network?",
            "type": "radio",
            "options": [
              "Yes",
              "No",
              "Not tested"
            ],
            "half": true
          },
          {
            "name": "security_tried_other_network",
            "label": "Has user tried another network or hotspot?",
            "type": "radio",
            "options": [
              "Yes",
              "No",
              "Not applicable"
            ],
            "half": true
          }
        ]
      },
      {
        "id": "sec-5",
        "title": "What is happening?",
        "fields": [
          {
            "name": "security_problem_summary",
            "label": "Problem summary",
            "type": "textarea"
          },
          {
            "name": "security_affected_service",
            "label": "Affected service or application",
            "type": "text",
            "help": "Examples: Outlook, Teams, SharePoint, OneDrive, Microsoft login, Authenticator, Defender, Company Portal"
          },
          {
            "name": "security_url_or_application",
            "label": "Specific URL or application",
            "type": "text",
            "placeholder": "If applicable"
          },
          {
            "name": "security_exact_error",
            "label": "Exact error message",
            "type": "textarea"
          },
          {
            "name": "security_trying_to_do",
            "label": "What was the user trying to do?",
            "type": "textarea"
          },
          {
            "name": "security_happened_instead",
            "label": "What happened instead?",
            "type": "textarea"
          },
          {
            "name": "security_every_time",
            "label": "Does the issue happen every time?",
            "type": "radio",
            "options": [
              "Yes",
              "No",
              "Intermittent"
            ],
            "half": true
          },
          {
            "name": "security_replicates_elsewhere",
            "label": "Can replicate it on another device / browser?",
            "type": "radio",
            "options": [
              "Yes",
              "No",
              "Not tested"
            ],
            "half": true
          },
          {
            "name": "security_working_access_path",
            "label": "Does the user still have any working access path?",
            "type": "text",
            "help": "Examples: phone access, Outlook mobile, Teams mobile, another compliant device"
          }
        ]
      },
      {
        "id": "sec-6",
        "title": "Timeline",
        "description": "Provide specific dates and times, including time zone.",
        "fields": [
          {
            "name": "security_time_last_success",
            "label": "Last known successful access",
            "type": "text",
            "placeholder": "Date/time",
            "half": true
          },
          {
            "name": "security_time_first_failure",
            "label": "First observed failure",
            "type": "text",
            "placeholder": "Date/time",
            "half": true
          },
          {
            "name": "security_time_device_change",
            "label": "Device enrollment/update/password/MFA/app change",
            "type": "text",
            "placeholder": "Date/time",
